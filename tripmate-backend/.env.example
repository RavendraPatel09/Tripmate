# Copy this file to `.env` and fill in real values for your machine.
# NEVER commit `.env` — it is already in .gitignore.

# --- App ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# Local (npm scripts):   postgresql://tripmate:tripmate@localhost:5432/tripmate
# Docker compose:        postgresql://tripmate:tripmate@postgres:5432/tripmate
DATABASE_URL=postgresql://tripmate:tripmate@localhost:5432/tripmate

# --- Redis (rate limiting / refresh-token denylist cache) ---
# Local:          redis://localhost:6379
# Docker compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -base64 64
# Access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookies ---
# Domain the refresh-token cookie is scoped to. Leave blank for localhost.
COOKIE_DOMAIN=
# Set to "true" in production (requires HTTPS). false is only for local http dev.
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated explicit allow-list. Never "*" — credentials (cookies) are used.
CORS_ORIGINS=http://localhost:3000

# --- Account security ---
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Logging ---
LOG_LEVEL=info
